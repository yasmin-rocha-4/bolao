// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}
datasource db {
   provider = "postgresql"
   url      = env("DATABASE_URL")
}
model Usuario {
  id Int @id @default(autoincrement())
  nome String
  cpf String @unique
  email String @unique
  telefone String?
  tipo_usuario String
  senha String
  status String
  apostas Aposta[]
}
model Campanha {
  id Int @id @default(autoincrement())
  nome String
  data_inicio DateTime
  data_fim DateTime
  tx_operacional Decimal @db.Decimal(10, 2)
  valor_bolao Decimal @db.Decimal(10, 2)
  is_publica Boolean
  codigo_campanha String
  status String
  opcoes CampanhaOpcoes[]
}

model CampanhaOpcoes {
  id Int @id @default(autoincrement())

  campanha_id          Int
  campanha             Campanha         @relation(fields: [campanha_id], references: [id])

  descricao            String

  status               String

  eh_resultado_final   Boolean          @default(false)

  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt

  @@unique([campanha_id, descricao])
  apostas Aposta[]

}

model Aposta {
  id Int @id @default(autoincrement())

  usuario_id Int
  usuario Usuario @relation(fields: [usuario_id], references: [id])

  campanha_opcao_id Int
  campanhaOpcao CampanhaOpcoes @relation(fields: [campanha_opcao_id], references: [id])

  status String

  meio_pagamento MeioPagamentoTipo

  comprovante String?

  dt_criacao DateTime @default(now())


  @@index([usuario_id])
  @@index([campanha_opcao_id])
  @@index([status])
}

enum MeioPagamentoTipo {
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  BOLETO
}